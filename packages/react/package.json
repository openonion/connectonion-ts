{
  "name": "@connectonion/react",
  "version": "0.2.0",
  "description": "React hooks for ConnectOnion agents - useAgentForHuman, useVoiceInput, and browser identity, on top of the connectonion TypeScript SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "connectonion",
    "react",
    "hooks",
    "nextjs",
    "llm"
  ],
  "author": "ConnectOnion Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/openonion/connectonion-react"
  },
  "bugs": {
    "url": "https://github.com/openonion/connectonion-react/issues"
  },
  "homepage": "https://github.com/openonion/connectonion-react#readme",
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "connectonion": "^0.2.0",
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "connectonion": "file:../..",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
